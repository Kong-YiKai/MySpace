# 复制为 .env.local 后填写。该文件已被 Git 忽略，勿提交真实密钥。
# 可填写 API 根地址（…/v1）或完整的 …/v1/chat/completions 地址。
SPATIAL_AGENT_BASE_URL=https://your-openai-compatible-endpoint.example/v1
SPATIAL_AGENT_API_KEY=
SPATIAL_AGENT_MODEL=luna

# 本地代理端口。浏览器只调用这个本机服务，密钥不会进入前端包。
SPATIAL_AGENT_PORT=8787
SPATIAL_AGENT_TIMEOUT_MS=45000

# 若你的兼容端点不支持 response_format: { type: "json_object" }，再改为 false。
SPATIAL_AGENT_JSON_MODE=true

# 多应用跳转：本地开发会自动走 Vite 默认端口；部署到非默认路径时再覆写。
VITE_MYSPACE_PANORAMA_URL=
VITE_MYSPACE_GARDEN_URL=
VITE_MYSPACE_BATTLE_URL=
