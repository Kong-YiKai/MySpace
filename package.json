{
  "name": "spatial-home-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted home viewing and decoration simulator built on an interactive 3D scene core.",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm --filter @spatial-intelligence/core build && pnpm -r --if-present typecheck",
    "check": "pnpm -r --if-present check",
    "dev": "pnpm --parallel --filter @spatial-home/web --filter @spatial-intelligence/api --filter @spatial-intelligence/generation-worker dev",
    "dev:web": "pnpm --filter @spatial-home/web dev",
    "dev:services": "pnpm --parallel --filter @spatial-intelligence/api --filter @spatial-intelligence/generation-worker dev",
    "infra:pull": "node scripts/prepare-infra-images.mjs",
    "infra:up": "node scripts/prepare-infra-images.mjs --local-only && docker compose --parallel 1 -f infra/compose.yaml up -d",
    "infra:status": "docker compose -f infra/compose.yaml ps",
    "infra:logs": "docker compose -f infra/compose.yaml logs -f --tail=100",
    "infra:down": "docker compose -f infra/compose.yaml down"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "4.0.18"
  },
  "packageManager": "pnpm@11.19.0"
}
