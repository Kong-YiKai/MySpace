{
  "name": "@spatial-intelligence/asset-generation-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/worker.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'dist/**'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@manycore/aholo-sdk-lux3d": "1.6.0",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@spatial-intelligence/contracts": "workspace:*",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "4.0.18"
  }
}
