{
  "name": "@spatial-intelligence/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/server.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'dist/**'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "@aws-sdk/s3-request-presigner": "^3.1118.0",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@spatial-intelligence/contracts": "workspace:*",
    "@types/pg": "^8.23.1",
    "fastify": "5.12.1",
    "pg": "^8.23.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "4.0.18"
  }
}
